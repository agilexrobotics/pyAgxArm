{
    "robot": "piper",
    "firmeware_version": "default",
    "comm": {
        "type": "can",
        "can": {
            "channel": "can0",
            "interface": "socketcan",
            "bitrate": 1000000,
            "enable_check_can": true,
            "auto_connect": true,
            "timeout": 0.001,
            "local_loopback": false,
            "receive_own_messages": false
        }
    },
    "auto_set_motion_mode": true,
    "enable_joint_limits": true,
    "joint_names": [
        "joint1",
        "joint2",
        "joint3",
        "joint4",
        "joint5",
        "joint6"
    ],
    "joint_limits": {
        "joint1": [-2.6179938, 2.6179938],
        "joint2": [0.0, 3.1415926],
        "joint3": [-2.9670597, 0.0],
        "joint4": [-1.7453292, 1.7453292],
        "joint5": [-1.2217304, 1.2217304],
        "joint6": [-2.0943951, 2.0943951]
    }
}
