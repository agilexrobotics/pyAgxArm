{
    "robot": "nero",
    "firmeware_version": "default",
    "comm": {
        "type": "can",
        "can": {
            "channel": "can0",
            "interface": "socketcan",
            "bitrate": 1000000,
            "enable_check_can": true,
            "auto_connect": true,
            "timeout": 0.001,
            "local_loopback": false,
            "receive_own_messages": false
        }
    },
    "log": {
        "level": "INFO",
        "path": ""
    },
    "auto_set_motion_mode": true,
    "enable_joint_limits": true,
    "joint_names": [
        "joint1",
        "joint2",
        "joint3",
        "joint4",
        "joint5",
        "joint6",
        "joint7"
    ],
    "joint_limits": {
        "joint1": [-2.70526, 2.70526],
        "joint2": [-1.74, 1.74],
        "joint3": [-2.75, 2.75],
        "joint4": [-1.01, 2.14],
        "joint5": [-2.75, 2.75],
        "joint6": [-0.73, 0.95],
        "joint7": [-1.5707963, 1.5707963]
    }
}
